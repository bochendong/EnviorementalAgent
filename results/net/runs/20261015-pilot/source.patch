     return diffs[int(.025 * reps)], diffs[int(.975 * reps)]
 
 
+def run_arms(qs, module, client, cfg, calls: int, cache: str, out: str) -> dict:
+    """Save each completed arm, checking the single-agent harness before spending time on debate."""
+    arms = {}
+    runners = [
+        ("official-single", lambda: official(qs, 1, 1, module, client, cfg)),
+        ("port-single", lambda: port(qs, "react", calls, tempfile.mkdtemp(dir=cache))),
+        ("official-debate", lambda: official(qs, 3, 2, module, client, cfg)),
+        ("port-debate", lambda: port(qs, "debate", calls, tempfile.mkdtemp(dir=cache))),
+    ]
+    for name, run in runners:
+        arms[name] = run()
+        progress = {"model": cfg.model, "n": len(qs), "complete": len(arms) == 4,
+                    "accuracy": {k: sum(v) / len(v) for k, v in arms.items()}, "per_question": arms}
+        if "port-single" in arms:
+            progress["single_gap"] = progress["accuracy"]["port-single"] - progress["accuracy"]["official-single"]
+            progress["single_gap_95"] = bootstrap(arms["port-single"], arms["official-single"])
+        path = os.path.join(out, "progress.json")
+        with open(path + ".tmp", "w") as f:
+            json.dump(progress, f, indent=1)
+        os.replace(path + ".tmp", path)
+        print(json.dumps({k: v for k, v in progress.items() if k != "per_question"}), flush=True)
+    return arms
+
+
