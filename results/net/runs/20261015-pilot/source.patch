+def test_fidelity_checkpoints_single_agent_comparison_first(tmp_path, monkeypatch):
+    from types import SimpleNamespace
+    from netagents import fidelity
+
+    order = []
+    cache = tmp_path / "cache"
+    cache.mkdir()
+
+    def official(qs, agents, rounds, module, client, cfg):
+        order.append("official-single" if agents == 1 else "official-debate")
+        if agents == 3:
+            progress = json.loads((tmp_path / "progress.json").read_text())
+            assert set(progress["accuracy"]) == {"official-single", "port-single"}
+            assert progress["single_gap"] == -.5 and not progress["complete"]
+        return [True, True]
+
+    def port(qs, design, calls, question_cache):
+        order.append("port-single" if design == "react" else "port-debate")
+        return [True, False]
+
+    monkeypatch.setattr(fidelity, "official", official)
+    monkeypatch.setattr(fidelity, "port", port)
+    arms = fidelity.run_arms([{}, {}], None, None, SimpleNamespace(model="mock"), 6, str(cache), str(tmp_path))
+    assert order == ["official-single", "port-single", "official-debate", "port-debate"]
+    progress = json.loads((tmp_path / "progress.json").read_text())
+    assert progress["complete"] and progress["per_question"] == arms
+    assert progress["single_gap_95"][0] <= -.5 <= progress["single_gap_95"][1]
+    assert not (tmp_path / "progress.json.tmp").exists()
+
+
